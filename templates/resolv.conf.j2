# {{ ansible_managed }}
# Managed by Ansible. The host resolver uses the locally running
# Technitium DNS Server. Do not edit by hand.
{% if technitium_nameservers is defined %}
{% for nameserver in technitium_nameservers %}
nameserver {{ nameserver }}
{% endfor %}
{% endif %}
{% if technitium_search_domains is defined %}
search {{ technitium_search_domains | join(' ') }}
{% endif %}
{% if technitium_resolv_options is defined %}
options {{ technitium_resolv_options | join(' ') }}
{% endif %}
